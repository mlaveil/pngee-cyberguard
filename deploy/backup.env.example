# Local backup retention
BACKUP_DIR=/var/lib/pngee/storage/backups
RETENTION_DAYS=30
MIN_BACKUPS=7
MAX_BACKUPS=35

# Optional S3-compatible offsite replication.
# Leave OFF until the operator has provisioned a private bucket and credentials.
OFFSITE_ENABLED=false
S3_BUCKET=
S3_PREFIX=pngee-cyberguard/
AWS_REGION=

# Server-side encryption for S3-compatible storage.
# Supported values depend on the configured object store; AES256 is the baseline.
S3_SSE=AES256
