# PNGee CyberGuard v3 production configuration
NODE_ENV=production
APP_MODE=production
DEPLOYMENT_MODE=on_prem
PORT=3000

# PostgreSQL bootstrap credentials (used only by docker-compose for the DB administrator)
POSTGRES_DB=pngee_cyberguard
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_ADMIN_PASSWORD
POSTGRES_APP_USER=pngee_app
POSTGRES_APP_PASSWORD=CHANGE_ME_LONG_RANDOM_APP_PASSWORD

# PostgreSQL application connection
DATABASE_URL=postgresql://pngee_app:CHANGE_ME_LONG_RANDOM_APP_PASSWORD@postgres:5432/pngee_cyberguard
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Authentication secrets - generate with a CSPRNG; never commit real values
JWT_ISSUER=pngee-cyberguard
JWT_AUDIENCE=pngee-cyberguard-web
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
AUTH_SECRET=CHANGE_ME_64_BYTE_RANDOM_SECRET

# Local storage
STORAGE_LOCAL_PATH=/var/lib/pngee/storage

# AI is optional; air-gapped installations should leave this unset
GEMINI_API_KEY=

# Reverse proxy / TLS is recommended. Never expose port 3000 directly to the Internet.
TRUST_PROXY=1
PUBLIC_BASE_URL=https://cyberguard.example.com
